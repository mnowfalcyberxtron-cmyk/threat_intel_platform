ABUSEIPDB_API_KEY=
AI_PROVIDER=auto

# Optional override; otherwise backend uses POSTGRES_URL from the Vercel Supabase integration.
VDM_DATABASE_URL=
VDM_ENABLE_SCHEDULER=false
VDM_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser-safe public rewrite path. Do not put private service URLs or secret keys here.
NEXT_PUBLIC_API_BASE_URL=/vendor/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
