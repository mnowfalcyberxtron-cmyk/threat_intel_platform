# Environment Configuration — DO NOT COMMIT .env

# Server
PORT=8002
HOST=0.0.0.0
DB_PATH=data/threat_intel.db

# AI Engine (choose one)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEYS=optional_extra_groq_key_1,optional_extra_groq_key_2
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=google/gemma-4-31b-it
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_API_KEY=

# Threat Intelligence APIs
RANSOMWARE_LIVE_API_KEY=your_key_here
ENABLE_RANSOMWARE_API=true
HIBR_API_KEY=your_hibr_key_here
ENABLE_HIBR=true
ABUSEIPDB_API_KEY=your_key_here
THREATFOX_API_KEY=your_key_here
RAPIDAPI_KEY=your_rapidapi_key_here
# ICS_RAPIDAPI_KEY can be used instead of RAPIDAPI_KEY if you prefer a scoped name.
ICS_RAPIDAPI_LATEST_LIMIT=100
ICS_CACHE_TTL_SECONDS=900
NVD_API_KEY=your_nvd_api_key_here

# Dark Web / Tor
ENABLE_DARKWEB=true
TOR_SOCKS_PORT=9050
TOR_SOCKS_PORT_FALLBACK=0
TOR_AUTO_START=true
TOR_AUTO_START_PORT=9050
TOR_BOOTSTRAP_TIMEOUT=120
ONION_MONITOR_INTERVAL=1800
EXCEL_INGESTION_INTERVAL=1800
EXCEL_INGESTION_ONEDRIVE_URL=https://1drv.ms/x/c/58897f49075b1bc5/IQCbQQAZ3G0DQ7m06TMh0ECXAeugC9AdA_q_3AWMmc2gyVc?e=Zf9Hoh&nav=MTVfezAwMDAwMDAwLTAwMDEtMDAwMC0wMDAwLTAwMDAwMDAwMDAwMH0
EXCEL_INGESTION_CHECK_STATUSES=true

# Admin credentials
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=change_this_master_login_password

# Signup notification email (SMTP)
# For Gmail, use an app password here, not your mailbox password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=admin@yourdomain.com
SMTP_PASSWORD=change_this_smtp_app_password
SMTP_FROM=admin@yourdomain.com
SMTP_TO=admin@yourdomain.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Auto-run all intelligence feeds on startup
AUTO_RUN_ALL_ON_STARTUP=false
RUN_ONION_MONITOR_IN_RUN_ALL=false
