{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "buildCommand": "pip install -r requirements.txt"
    },
    "vendor_backend": {
      "root": "vendor-disclosure-monitor/backend",
      "framework": "fastapi",
      "entrypoint": "app.main:app",
      "buildCommand": "pip install -r requirements.txt"
    },
    "vendor_frontend": {
      "root": "vendor-disclosure-monitor/frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/vendor/api",
      "destination": {
        "service": "vendor_backend",
        "path": "/"
      }
    },
    {
      "source": "/vendor/api/:path*",
      "destination": {
        "service": "vendor_backend",
        "path": "/:path*"
      }
    },
    {
      "source": "/vendor",
      "destination": {
        "service": "vendor_frontend"
      }
    },
    {
      "source": "/vendor/:path*",
      "destination": {
        "service": "vendor_frontend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/refresh",
      "schedule": "0 */6 * * *"
    }
  ]
}
